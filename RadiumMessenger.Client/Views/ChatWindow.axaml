<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RadiumMessenger.Client.ViewModels"
        xmlns:models="using:RadiumMessenger.Client.Models"
        x:Class="RadiumMessenger.Client.Views.ChatWindow"
        x:DataType="vm:ChatViewModel"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        Title="Radium Messenger"
        WindowStartupLocation="CenterScreen"
        Background="#17191F">

    <Grid ColumnDefinitions="300,*">

        <!-- Левая панель -->
        <Border Grid.Column="0"
                Background="#20232B"
                Padding="15">

            <Grid RowDefinitions="Auto,Auto,*">

                <TextBlock Text="RADIUM"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="5,5,5,20"/>

            <StackPanel Grid.Row="1" Spacing="5">

                <TextBox Text="{Binding SearchQuery}"
                         Watermark="Поиск пользователей...">
                    <TextBox.KeyBindings>
						<KeyBinding Gesture="Enter"
                                    Command="{Binding SearchUsersCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <ListBox ItemsSource="{Binding SearchResults}"
                         Background="#292D38"
                         BorderThickness="0"
                         MaxHeight="150">
					
                    <ListBox.ItemTemplate>
						<DataTemplate x:DataType="models:User">
							<Button Content="{Binding Username}"
                                    Command="{Binding $parent[ListBox].((vm:ChatViewModel)DataContext).CreateChatCommand}"
                                    CommandParameter="{Binding}"
                                    Background="#292D38"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>

                <StackPanel Grid.Row="2"
                            Spacing="10">

                    <TextBlock Text="Чаты"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <ListBox ItemsSource="{Binding Chats}"
                             SelectedItem="{Binding SelectedChat}"
                             Background="Transparent"
                             BorderThickness="0">

                        <ListBox.ItemTemplate>
							<DataTemplate x:DataType="models:Chat">
								<Border Background="#292D38"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,3">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">

                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="18"
                                                Background="{Binding AvatarColor}"
                                                VerticalAlignment="Center">
											<TextBlock Text="{Binding AvatarLetter}"
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>    
                                    
                                        <StackPanel VerticalAlignment="Center"
                                                    Spacing="3">
											<TextBlock Text="{Binding OtherUsername}"
                                                       Foreground="White"
                                                       FontSize="15"/>

                                            <TextBlock Text="{Binding LastMessageText}"
                                                       Foreground="#9A9DA8"
                                                       FontSize="12"
                                                       MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                    </StackPanel>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </StackPanel>

            </Grid>
        </Border>

        <!-- Область переписки -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto">

            <Border Background="#20232B"
                    Padding="20">

                <StackPanel Orientation="Horizontal"
                            Spacing="5">
					<TextBlock Text="Чат №"
                               FontSize="20"
                               Foreground="White"/>

                    <TextBlock Text="{Binding SelectedChat.Id}"
                               FontSize="20"
                               Foreground="White"/>

                </StackPanel>

            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Messages}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="models:Message">
								<Border Background="#292D38"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="10,5">

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="5">
                                            <TextBlock Text="{Binding LocalTime}"
                                                       Foreground="#9298A5"
                                                       FontSize="11"/>

                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="12"
                                                       FontWeight="Bold"/>
                                            
                                        </StackPanel>
										
                                    </StackPanel>
									
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="#20232B"
                    Padding="15">

                <Grid ColumnDefinitions="*,Auto">

                    <TextBox Text="{Binding MessageText}"
                             Watermark="Напишите сообщение..."
                             VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Отправить"
                            Command="{Binding SendMessageCommand}"
                            Background="#5865F2"
                            Foreground="White"
                            Margin="10,0,0,0"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>